# syntax=docker/dockerfile:1
# Cyber-Inference NVIDIA image for Thor ARM64.
# The self-hosted thor.lab workflow builds llama.cpp natively, stages the
# resulting llama-server bundle under docker/build/llama-bin, and this image
# consumes that prepared artifact without compiling inside Docker.

ARG BASE_IMAGE=nvcr.io/nvidia/cuda:13.0.0-runtime-ubuntu24.04
FROM ${BASE_IMAGE} AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CYBER_INFERENCE_DATA_DIR=/app/data \
    CYBER_INFERENCE_MODELS_DIR=/app/models \
    CYBER_INFERENCE_BIN_DIR=/app/bin \
    CYBER_INFERENCE_HOST=0.0.0.0 \
    CYBER_INFERENCE_PORT=8337 \
    CYBER_INFERENCE_LOG_LEVEL=INFO \
    CYBER_INFERENCE_LLAMA_GPU_LAYERS=-1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    LD_LIBRARY_PATH=/app/bin:${LD_LIBRARY_PATH} \
    PATH=/app/bin:/root/.local/bin:/root/.cargo/bin:/app/.venv/bin:${PATH}

WORKDIR /app

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libcurl4-openssl-dev \
        libgomp1 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv; \
    rm -rf /var/lib/apt/lists/*; \
    curl -LsSf https://astral.sh/uv/install.sh | sh

COPY pyproject.toml uv.lock README.md start.sh .python-version ./
COPY src/ ./src/
COPY docker/build/llama-bin/ /app/bin/

RUN set -eux; \
    test -x /app/bin/llama-server; \
    chmod +x start.sh /app/bin/llama-server; \
    mkdir -p /app/data/logs /app/models; \
    uv sync --frozen --no-dev; \
    which llama-server; \
    /app/bin/llama-server --version

EXPOSE 8337
VOLUME ["/app/data", "/app/models"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:8337/health || exit 1

CMD ["./start.sh"]
