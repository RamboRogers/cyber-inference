# syntax=docker/dockerfile:1
# Cyber-Inference NVIDIA image for Linux AMD64.
# Builds a pinned CUDA-enabled llama.cpp release from source and bakes
# llama-server plus its runtime libraries into /app/bin.

ARG CUDA_IMAGE=nvcr.io/nvidia/cuda:13.0.0-devel-ubuntu24.04
ARG LLAMA_CPP_VERSION=b8816

FROM ${CUDA_IMAGE} AS llama-builder
ARG LLAMA_CPP_VERSION
ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        curl \
        g++ \
        git \
        libc6-dev \
        ninja-build; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN set -eux; \
    git clone --depth 1 --branch "${LLAMA_CPP_VERSION}" https://github.com/ggml-org/llama.cpp llama.cpp; \
    cmake -S llama.cpp -B llama.cpp/build -DGGML_CUDA=ON -DCMAKE_BUILD_TYPE=Release -G Ninja; \
    cmake --build llama.cpp/build --config Release -j"$(nproc)" --target llama-server; \
    mkdir -p /opt/llama-bin; \
    cp -a llama.cpp/build/bin/llama-server /opt/llama-bin/; \
    find llama.cpp/build -type f \( -name 'libggml*.so*' -o -name 'libllama*.so*' -o -name 'libmtmd*.so*' \) -exec cp -a {} /opt/llama-bin/ \;; \
    find llama.cpp/build -type l \( -name 'libggml*.so*' -o -name 'libllama*.so*' -o -name 'libmtmd*.so*' \) -exec cp -a {} /opt/llama-bin/ \;; \
    LD_LIBRARY_PATH=/opt/llama-bin:${LD_LIBRARY_PATH:-} /opt/llama-bin/llama-server --version

FROM ${CUDA_IMAGE} AS runtime
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CYBER_INFERENCE_DATA_DIR=/app/data \
    CYBER_INFERENCE_MODELS_DIR=/app/models \
    CYBER_INFERENCE_BIN_DIR=/app/bin \
    CYBER_INFERENCE_HOST=0.0.0.0 \
    CYBER_INFERENCE_PORT=8337 \
    CYBER_INFERENCE_LOG_LEVEL=INFO \
    CYBER_INFERENCE_LLAMA_GPU_LAYERS=-1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    LD_LIBRARY_PATH=/app/bin:${LD_LIBRARY_PATH} \
    PATH=/app/bin:/root/.local/bin:/root/.cargo/bin:/app/.venv/bin:${PATH}

WORKDIR /app

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libcurl4-openssl-dev \
        libgomp1 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv; \
    rm -rf /var/lib/apt/lists/*; \
    curl -LsSf https://astral.sh/uv/install.sh | sh

COPY pyproject.toml uv.lock README.md start.sh .python-version ./
COPY src/ ./src/
COPY --from=llama-builder /opt/llama-bin/ /app/bin/

RUN set -eux; \
    chmod +x start.sh /app/bin/llama-server; \
    mkdir -p /app/data/logs /app/models; \
    uv sync --frozen; \
    which llama-server; \
    /app/bin/llama-server --version

EXPOSE 8337
VOLUME ["/app/data", "/app/models"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:8337/health || exit 1

CMD ["./start.sh"]
